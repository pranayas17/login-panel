        "import requests\n",
        "from bs4 import BeautifulSoup\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import time\n",
        "import re # Added for robust price cleaning"
      ],
      "metadata": {
        "id": "7FW4RP4WqvE3"
      },
      "execution_count": 21,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "BASE_URL = \"http://books.toscrape.com/catalogue/page-{}.html\"\n",
        "\n",
        "def scrape_page(page_num):\n",
        "    url = BASE_URL.format(page_num)\n",
        "    response = requests.get(url)\n",
        "    if response.status_code != 200:\n",
        "        return None\n",
        "    soup = BeautifulSoup(response.text, \"html.parser\")\n",
        "    books = soup.find_all(\"article\", class_=\"product_pod\")\n",
        "    data = []\n",
        "    rating_map = {\"One\": 1, \"Two\": 2, \"Three\": 3, \"Four\": 4, \"Five\": 5}\n",
        "    for book in books:\n",
        "        title = book.h3.a[\"title\"]\n",
        "        # Clean the price string to remove any non-numeric characters except the decimal point\n",
        "        price_str = book.find(\"p\", class_=\"price_color\").text.strip()\n",
        "        # Use regex to keep only digits and periods for robust cleaning\n",
        "        cleaned_price = re.sub(r'[^\\d.]', '', price_str)\n",
        "        price = float(cleaned_price)\n",
        "        availability = book.find(\"p\", class_=\"instock availability\").text.strip()\n",
        "        rating_class = book.find(\"p\", class_=\"star-rating\")[\"class\"][1]\n",
        "        rating = rating_map.get(rating_class, 0)\n",
        "        data.append({\"title\": title, \"price\": price, \"rating\": rating, \"availability\": availability})\n",
        "    return data\n",
        "\n",
        "def scrape_all_books(max_pages=50):\n",
        "    all_books = []\n",
        "    for page in range(1, max_pages + 1):\n",
        "        print(f\"Scraping page {page}...\")\n",
        "        page_data = scrape_page(page)\n",
        "        if not page_data:\n",
        "            print(\"No more pages. Stopping.\")\n",
        "            break\n",
        "        all_books.extend(page_data)\n",
        "        time.sleep(1)\n",
        "    return all_books"
      ],
